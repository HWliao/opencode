+87: export type ProjectDirectoryEntry = { name: string; absolute: string }
+88: 
+89: export function normalizeProjectInput(input: string) {
+90:   const value = input.replaceAll("\\", "/")
+91:   if (/^[A-Za-z]:\/$/.test(value)) return value
+92:   return value.replace(/\/+$/g, "")
+93: }
+94: 
+95: export function projectParentDirectory(input: string) {
+96:   return normalizeProjectInput(getDirectory(normalizeProjectInput(input))).replace(/\/+$/g, "")
+97: }
+98: 
+99: function hasRoot(input: string) {
+100:   return input.startsWith("/") || input.startsWith("//") || /^[A-Za-z]:\//.test(input)
+101: }
+102: 
+103: export function joinProjectInput(base: string, input: string) {
+104:   const value = normalizeProjectInput(input.trim())
+105:   if (!value) return normalizeProjectInput(base)
+106:   if (hasRoot(value)) return value
+107:   return `${normalizeProjectInput(base)}/${value}`
+108: }
+109: 
+110: export function filterProjectDirectories(items: ProjectDirectoryEntry[], input: string) {
+111:   const query = normalizeProjectInput(input).split("/").at(-1) ?? ""
+112:   if (!query) return items
+113:   return fuzzysort.go(query, items, { key: "name" }).map((item) => item.obj)
+114: }
+115: ```
