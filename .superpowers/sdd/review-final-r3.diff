### packages/opencode/src/server/routes/instance/httpapi/handlers/directory.ts
+1: import { FSUtil } from "@opencode-ai/core/fs-util"
+2: import { Effect } from "effect"
+3: import path from "path"
+4: import { HttpApiBuilder, HttpApiError } from "effect/unstable/httpapi"
+5: import { InstanceHttpApi } from "../api"
+6: 
+7: export const directoryHandlers = HttpApiBuilder.group(InstanceHttpApi, "directory", (handlers) =>
+8:   Effect.gen(function* () {
+9:     const fs = yield* FSUtil.Service
+10: 
+11:     const list = Effect.fn("DirectoryHttpApi.list")(function* (ctx: { query: { path: string } }) {
+12:       if (!isAbsoluteInput(ctx.query.path)) return yield* new HttpApiError.BadRequest({})
+13:       const directory = yield* fs.resolve(ctx.query.path).pipe(Effect.catchDefect(() => new HttpApiError.BadRequest({})))
+14:       if (!(yield* fs.isDir(directory).pipe(Effect.catch(() => new HttpApiError.BadRequest({})))))
+15:         return yield* new HttpApiError.BadRequest({})
+16:       const entries = yield* fs.readDirectoryEntries(directory).pipe(Effect.mapError(() => new HttpApiError.BadRequest({})))
+17:       return entries
+18:         .filter((entry) => entry.type === "directory")
+19:         .map((entry) => ({ name: entry.name, absolute: path.join(directory, entry.name) }))
+20:         .sort((a, b) => a.name.localeCompare(b.name))
+21:     })
+22: 
+23:     return handlers.handle("list", list)
+24:   }),
+25: )
+26: 
+27: function isAbsoluteInput(input: string) {
+28:   return path.isAbsolute(input) || /^[A-Za-z]:[\\/]/.test(input)
+29: }

